services:
  backend:
    image: python:3.12-slim
    working_dir: /app
    volumes:
      - ./backend:/app/backend
    command: sh -c "pip install -r backend/requirements.txt && python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000"
    ports:
      - "8000:8000"
    environment:
      MAILTRACE_ENV: development
      MAILTRACE_CORS_ORIGINS: '["http://localhost:5173","http://127.0.0.1:5173"]'
