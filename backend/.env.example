# MailTrace Backend Environment Configuration
# Copy this file to .env and fill in your values.

# --- Network & Safety Permissions ---
ALLOW_NETWORK=true
ALLOW_DETONATION=true
DEMO_MODE=false

# --- Automated SOC Alerting ---
DISCORD_WEBHOOK_URL=
ALERT_WEBHOOK_ENABLED=true
ALERT_MIN_RISK=50.0

# --- Live Threat Intelligence API Keys ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- API & Server Settings ---
MAILTRACE_HOST=127.0.0.1
MAILTRACE_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000

# --- Supabase (optional mirror) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- MaxMind GeoIP (optional, use download_geoip.py for free databases) ---
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# --- Blockchain / Chain of Custody ---
WEB3_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
MAILCUSTODY_ADDRESS=
DEPLOYER_PRIVATE_KEY=
CHAIN_EXPLORER_BASE=

# --- LLM Narrative (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
HF_API_TOKEN=

# --- Detection Thresholds ---
CONCLUSIVE_LOW=20.0
CONCLUSIVE_HIGH=80.0
SLA_MINUTES=20

# --- Privacy ---
PII_MASKING=true
EVIDENCE_RETENTION_DAYS=30

# --- Organisation ---
ORG_NAME=MailTrace SOC
ANALYST_NAME=unassigned
